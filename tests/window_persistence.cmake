set(state "${TEST_DIR}/window-size-test.txt")
file(WRITE "${state}" "1234 789\n")
execute_process(COMMAND "${GAME}" --window-state-test "${state}" 1234 789 RESULT_VARIABLE first)
if(NOT first EQUAL 0)
  message(FATAL_ERROR "First window restoration failed")
endif()
file(READ "${state}" content)
if(NOT content STREQUAL "1100 700 2\n")
  message(FATAL_ERROR "Resized dimensions were not saved: ${content}")
endif()
execute_process(COMMAND "${GAME}" --window-state-test "${state}" 1100 700 RESULT_VARIABLE second)
if(NOT second EQUAL 0)
  message(FATAL_ERROR "Window restoration on second launch failed")
endif()
file(REMOVE "${state}")
