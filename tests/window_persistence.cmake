set(state "${TEST_DIR}/window-size-test.txt")
if(NOT DEFINED INITIAL_WIDTH)
  set(INITIAL_WIDTH 1234)
  set(INITIAL_HEIGHT 789)
  set(RESIZE_WIDTH 1100)
  set(RESIZE_HEIGHT 700)
endif()
file(WRITE "${state}" "${INITIAL_WIDTH} ${INITIAL_HEIGHT}\n")
execute_process(COMMAND "${GAME}" --window-state-test "${state}"
  ${INITIAL_WIDTH} ${INITIAL_HEIGHT} ${RESIZE_WIDTH} ${RESIZE_HEIGHT} 2 RESULT_VARIABLE first)
if(NOT first EQUAL 0)
  message(FATAL_ERROR "First window restoration failed")
endif()
file(READ "${state}" content)
if(NOT content STREQUAL "${RESIZE_WIDTH} ${RESIZE_HEIGHT} 3 3\n")
  message(FATAL_ERROR "Resized dimensions were not saved: ${content}")
endif()
execute_process(COMMAND "${GAME}" --window-state-test "${state}"
  ${RESIZE_WIDTH} ${RESIZE_HEIGHT} ${RESIZE_WIDTH} ${RESIZE_HEIGHT} 3 RESULT_VARIABLE second)
if(NOT second EQUAL 0)
  message(FATAL_ERROR "Window restoration on second launch failed")
endif()
file(REMOVE "${state}")
